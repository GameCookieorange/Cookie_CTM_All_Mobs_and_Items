execute if score @s orange_timer matches ..15 at @s if entity @e[type=#minecraft:attack_entity ,distance=..12] run particle minecraft:dust_color_transition{from_color:[0.000,0.765,1.000],to_color:[0.871,0.933,1.000],scale:1} ^1.5 ^2 ^ 0 0 0 2 3 force

execute if score @s orange_timer matches ..15 at @s if entity @e[type=#minecraft:attack_entity ,distance=..12] run particle minecraft:cloud ^ ^3 ^ 0 0 0 0.01 1 force

execute if score @s orange_timer matches 10..15 at @s unless entity @e[type=#minecraft:attack_entity ,distance=..12] run scoreboard players set @s orange_timer 10
execute if score @s orange_timer matches 10..15 at @s if entity @e[type=#minecraft:attack_entity ,distance=..12] run scoreboard players set @s orange_timer 20

