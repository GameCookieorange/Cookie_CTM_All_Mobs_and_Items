scoreboard players add @s brown_timer 1

execute if score @s brown_timer matches 0..15 if entity @e[type=blaze, tag=brown.fiery_steam, distance=..6, sort=nearest, limit=2] run scoreboard players set @s brown_timer 1
execute if score @s brown_timer matches 0..15 if entity @e[type=magma_cube, tag=brown.magma_residue, distance=..6, sort=nearest, limit=4] run scoreboard players set @s brown_timer 1

execute if score @s brown_timer matches 10..15 if entity @e[type=!#minecraft:not_mob,tag=!brown.steampunk, distance=..18] run scoreboard players set @s brown_timer 16
execute if score @s brown_timer matches 10..15 unless entity @e[type=!#minecraft:not_mob, tag=!brown.steampunk, distance=..18] run scoreboard players set @s brown_timer 10

execute if score @s[type=husk, tag=brown.turret_1] brown_timer matches 20 run effect give @s glowing 2
execute if score @s[type=husk, tag=brown.turret_1] brown_timer matches 60 run function brown:automatic_turret/choose

execute if score @s[type=husk, tag=brown.turret_2] brown_timer matches 40 run effect give @s glowing 2
execute if score @s[type=husk, tag=brown.turret_2] brown_timer matches 80 run function brown:automatic_turret/choose

execute if score @s[type=husk, tag=brown.turret_core] brown_timer matches 50 run effect give @s glowing 2
execute if score @s[type=husk, tag=brown.turret_core] brown_timer matches 100 run function brown:automatic_turret/choose

execute if score @s brown_timer matches 600.. run scoreboard players set @s brown_timer 0

execute as @s[tag=!brown.turret_top, tag=!brown.turret_bottom] unless predicate brown:is_vehicle run kill @s
execute as @s[tag=!brown.turret_top, tag=!brown.turret_bottom] unless predicate brown:is_sitting run kill @s

execute as @s[tag=brown.turret_top] unless predicate brown:is_sitting run kill @s
execute as @s[tag=brown.turret_bottom] unless predicate brown:is_vehicle run kill @s

