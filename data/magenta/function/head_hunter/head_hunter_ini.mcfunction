scoreboard players add @s magenta_timer 1

execute if score @s magenta_timer matches 1 at @s[tag=!magenta.has_a_skull] run execute unless items entity @s armor.head #magenta:is_head run function magenta:head_hunter/break_area

execute if score @s magenta_timer matches 20.. at @s run scoreboard players set @s magenta_timer 0

#=========================================================================

execute if items entity @s armor.head #magenta:is_head if entity @e[type=#minecraft:attack_entity,distance=..20] run scoreboard players add @s magenta_skill 1

execute if score @s magenta_skill matches 1..100 run effect give @s minecraft:glowing 1 0 true

execute if score @s magenta_skill matches 100.. run function magenta:head_hunter/head/head_shooting

