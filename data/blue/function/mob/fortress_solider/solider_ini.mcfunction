scoreboard players add @s blue_timer 1

execute if score @s[predicate=!blue:is_in_water] blue_timer matches 10..15 if entity @e[type=!#minecraft:not_mob, sort=nearest, limit=1, distance=..10, tag=!blue.ocean_army] run scoreboard players set @s blue_timer 16
execute if score @s blue_timer matches 10..15 unless entity @e[type=!#minecraft:not_mob, sort=nearest, limit=1, distance=..10, tag=!blue.ocean_army] run scoreboard players set @s blue_timer 10

execute if score @s blue_timer matches 20 run effect give @s glowing 1 1 true 

execute if score @s blue_timer matches 20 at @s run playsound block.bell.use hostile @a ~ ~ ~ 0.8 2 1

execute if score @s blue_timer matches 40 at @s run tp @s ^ ^ ^ facing entity @e[type=!#minecraft:not_mob, tag=!blue.ocean_army, team=!blue_ocean_army, limit=1, sort=nearest]

execute if score @s blue_timer matches 40 run function blue:mob/fortress_solider/deside

execute if score @s blue_timer matches 260.. run scoreboard players set @s blue_timer 0


