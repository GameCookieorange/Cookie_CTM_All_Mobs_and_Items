execute unless predicate blue:being_sat run tag @s[tag=!blue.nautilus_no_drown] add blue.nautilus_no_drown

scoreboard players add @s[tag=blue.nautilus_no_drown] blue_debug 1

execute if score @s blue_debug matches 560..600 run particle bubble_column_up ~ ~ ~ 0.8 0.8 0.8 1 30 normal

execute if score @s blue_debug matches 600.. run kill @s

