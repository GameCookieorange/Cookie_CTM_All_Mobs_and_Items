scoreboard players add @s orange_timer 1

execute if score @s orange_timer matches 10..12 if entity @e[team=orange_goblin, distance=..16, tag=!orange.goblin_chef] run scoreboard players set @s orange_timer 15
execute if score @s orange_timer matches 10..12 unless entity @e[team=orange_goblin, distance=..16, tag=!orange.goblin_chef] run scoreboard players set @s orange_timer 10

execute if score @s orange_timer matches 35..40 run tp @s ^ ^ ^ facing entity @e[team=orange_goblin, distance=..10, limit=1, sort=nearest, tag=!orange.goblin_chef] eyes

execute if score @s orange_timer matches 40 at @s run summon splash_potion ^-0.5 ^ ^0.8 {NoGravity:0b,Glowing:1b,Tags:["orange.dinner_left"],Passengers:[{id:"minecraft:armor_stand",Silent:1b,Invulnerable:1b,ShowArms:0b,Small:1b,Marker:1b,Invisible:1b,NoBasePlate:1b,Tags:["orange.dinner"]}],Item:{id:"minecraft:suspicious_stew",count:1,components:{"minecraft:potion_contents":{custom_color:3765539,custom_effects:[{id:"minecraft:nausea",amplifier:1,duration:60,show_particles:1b}]},enchantment_glint_override:true}}}

execute if score @s orange_timer matches 40 at @s run summon splash_potion ^0.5 ^ ^0.8 {NoGravity:0b,Glowing:1b,Tags:["orange.dinner_right"],Passengers:[{id:"minecraft:armor_stand",Silent:1b,Invulnerable:1b,ShowArms:0b,Small:1b,Marker:1b,Invisible:1b,NoBasePlate:1b,Tags:["orange.dinner"]}],Item:{id:"minecraft:suspicious_stew",count:1,components:{"minecraft:potion_contents":{custom_color:3765539,custom_effects:[{id:"minecraft:nausea",amplifier:1,duration:60,show_particles:1b}]},enchantment_glint_override:true}}}

execute if score @s orange_timer matches 160.. at @s run scoreboard players set @s orange_timer 0


